# Copy to /srv/vikkaa/app/.env.production on the server and fill in. Never commit the real file.
NODE_ENV=production
PUBLIC_HOST=vikkaa.lk
APP_HOST=app.vikkaa.lk

# Database (the db container reads POSTGRES_*, the app reads DATABASE_URL)
POSTGRES_USER=vikkaa
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=vikkaa
DATABASE_URL=postgres://vikkaa:change-me-long-random@db:5432/vikkaa

# openssl rand -hex 32
APP_SECRET=
# openssl rand -base64 32  (keeps server-action references stable across restarts)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

VIKKAA_PHONE=+94770000000
VIKKAA_WHATSAPP=+94770000000
STAFF_NOTIFY_EMAILS=founder1@example.com,founder2@example.com
VAT_RATE_BP=0

BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_BRANCH=

# "Campaigns from" on /how-it-works, in cents (Rs 75,000 = 7500000)
PRICE_GUIDE_PROPERTY_CENTS=0
PRICE_GUIDE_VEHICLE_CENTS=0

NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=
RESEND_API_KEY=
MAIL_FROM=hello@vikkaa.lk
